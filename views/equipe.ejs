<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon équipe</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!--include le fichier navbar.ejs pour avoir la barre de navigation -->
    <%- include('navbar') -%>

    <h2>Notre Équipe MayGourmet</h2>
    <% resultatEquipe.forEach((result) => { %>
        <div class="card">
            <img src="/image/photo-1638429250966-15c61a0982b9.avif" alt="" class="team">
            <div class="container">
                <h4><b><%= result.nom %> <%= result.prenom %></b></h4>
                <p><%= result.poste %></p>
                <input type="button" value="supprimer" onclik="supprimer('<%= result.id =%>')">
            </div>
        </div>
    <%}); %>

</body>
<script>
    
</script>
</html>